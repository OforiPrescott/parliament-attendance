# --- Database ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=parliament_attendance
DB_USER=pa_app
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
# Set to true for managed/remote PostgreSQL that requires TLS
DB_SSL=false

# --- Application ------------------------------------------------------
# Public origin the app is served from (used for CSRF origin checks)
APP_ORIGIN=http://localhost:3000
# Set to true behind HTTPS (marks session cookie Secure)
COOKIE_SECURE=false
# Where uploaded MP photographs are stored (outside /public)
UPLOAD_DIR=./storage/uploads
# Trust X-Forwarded-For from the reverse proxy for audit IPs
TRUST_PROXY=false

# --- Initial administrator (used by `npm run db:create-admin`) -----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@parliament.gh
ADMIN_FULL_NAME=System Administrator
